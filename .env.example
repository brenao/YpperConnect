# NAO use aspas ao redor dos valores.
#
# O `node --env-file` remove as aspas; o `docker --env-file` NAO remove -- ele
# pega tudo depois do `=` como literal. Uma senha entre aspas funciona na
# maquina do dev e falha dentro do container, com a mensagem inutil
# "password authentication failed". Aconteceu no rosset29 em 2026-08-13.
#
# Certo:   PG_PASSWORD=abc123
# Errado:  PG_PASSWORD="abc123"

# ---- Supabase (v2 multi-tenant) ----
# Projeto dev: beagleone-dev. A chave anon e publica; aqui fica so no servidor.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>

# service_role IGNORA o RLS. Usada apenas em src/integrations/supabase/admin.server.ts
# (convite de usuarios e link de acesso), sempre depois de checar permissao.
# Nunca com prefixo VITE_, nunca em codigo que roda no navegador.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Endereco publico do app, usado nos links de convite. Inclua o prefixo, se
# houver (ex.: https://servidor/beagleone). Vazio: usa o endereco da requisicao.
APP_URL=

# ---- Banco PostgreSQL (legado, sai conforme os modulos migram) ----
# rosset96 = teste, rosset97 = producao.
# O usuario da APLICACAO e `ypper` (dono das tabelas). Conta pessoal de dev
# so no desenvolvimento local.
PG_HOST=<Host Postgres>
PG_PORT=5432
PG_USER=ypper
PG_PASSWORD=<Pwd>
PG_DATABASE=ypper
PG_POOL_LIMIT=10

# Fuso da sessao do banco. Opcional: sem ele vale America/Sao_Paulo.
# Nome de zona, nao deslocamento fixo (-03:00), para o horario de verao
# continuar correto se um dia voltar.
PG_TIMEZONE=America/Sao_Paulo

# IA (endpoint compatível com OpenAI)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# SMTP corporativo
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=YpperConnect <noreply@rosset.com.br>
SMTP_REJECT_UNAUTHORIZED=true

GLPI_USUARIOS_URL=https://10.0.0.33/portal-chamados/listar-usuarios.php
GLPI_USUARIOS_SECRET=
GLPI_TLS_REJECT_UNAUTHORIZED=false

CRON_TOKEN=
# ---- Portal externo de abrir chamado ----
# Preenchida: o botao "Abrir chamado", o menu "Chamados" e a pagina inicial
# passam a apontar para esta URL. Vazia: formulario interno.
# ATENCAO: prefixo VITE_ = valor gravado no build, nao lido em runtime.
# Localmente o Vite le este arquivo. No servidor, o script de deploy le esta
# linha e repassa como --build-arg -- so trocar o .env e recriar o container
# NAO muda nada; precisa rodar o atualizar-*.sh de novo.
VITE_URL_ABRIR_CHAMADO=
