# NAO use aspas ao redor dos valores.
#
# O `node --env-file` remove as aspas; o `docker --env-file` NAO remove -- ele
# pega tudo depois do `=` como literal. Uma senha entre aspas funciona na
# maquina do dev e falha dentro do container, com a mensagem inutil
# "password authentication failed". Aconteceu no rosset29 em 2026-08-13.
#
# Certo:   PG_PASSWORD=abc123
# Errado:  PG_PASSWORD="abc123"

# ---- Banco PostgreSQL ----
# rosset96 = teste, rosset97 = producao.
# O usuario da APLICACAO e `ypper` (dono das tabelas). Conta pessoal de dev
# so no desenvolvimento local.
PG_HOST=<Host Postgres>
PG_PORT=5432
PG_USER=ypper
PG_PASSWORD=<Pwd>
PG_DATABASE=ypper
PG_POOL_LIMIT=10

# Fuso da sessao do banco. Opcional: sem ele vale America/Sao_Paulo.
# Nome de zona, nao deslocamento fixo (-03:00), para o horario de verao
# continuar correto se um dia voltar.
PG_TIMEZONE=America/Sao_Paulo

# IA (endpoint compatível com OpenAI)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# SMTP corporativo
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=YpperConnect <noreply@rosset.com.br>
SMTP_REJECT_UNAUTHORIZED=true
